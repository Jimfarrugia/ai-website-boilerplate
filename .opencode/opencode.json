{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright-chromium": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser=chromium",
          "--headless"
        ]
      },
      "playwright-firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser=firefox",
          "--headless"
        ]
      }
    }
  }
}
